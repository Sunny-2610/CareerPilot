# LLM providers - Groq is primary, OpenRouter is fallback.
# Keys are only read if set to a real value; placeholder values are ignored.

# Groq (https://console.groq.com/keys) - tried first
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# OpenRouter (https://openrouter.ai/keys) - used if all Groq models fail
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODELS=google/gemini-2.5-flash,nvidia/nemotron-3.5-lightning:free

# Cloud PostgreSQL (Neon or Supabase free tier). Leave empty to use local
# SQLite (backend/careerpilot.db) so the app runs offline.
# Example: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
